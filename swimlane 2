def build_pipeline(workbook_path: str, lane_overrides: Optional[Dict[str, str]] = None):
    edges = extract_cross_sheet_refs(workbook_path)
    G = build_sheet_graph(edges)
    lanes = classify_lanes(G, overrides=lane_overrides)
    return edges, G, lanes


def main():
    ap = argparse.ArgumentParser(description="Build a swimlane process-flow diagram from an Excel workbook.")
    ap.add_argument("workbook", help="Path to .xlsx workbook")
    ap.add_argument("--out", default="swimlane.png", help="Output file path (.png or .html)")
    ap.add_argument("--html", action="store_true", help="Render interactive HTML instead of static PNG")
    ap.add_argument(
        "--lanes", nargs="*",
        help='Manual lane overrides, e.g. --lanes "Input:Sheet1,Sheet2" "Output:Sheet3"',
    )
    ap.add_argument("--dump-edges", help="Optional path to dump raw cell-level edges as JSON")
    args = ap.parse_args()

    overrides = parse_lane_overrides(args.lanes)
    edges, G, lanes = build_pipeline(args.workbook, overrides)

    print(f"Found {len(edges)} cross-sheet formula references across {G.number_of_nodes()} sheets.")
    for sheet, lane in sorted(lanes.items(), key=lambda x: x[1]):
        print(f"  [{lane:8s}] {sheet}")

    if args.dump_edges:
        Path(args.dump_edges).write_text(
            json.dumps([e.__dict__ for e in edges], indent=2), encoding="utf-8"
        )

    if args.html or args.out.endswith(".html"):
        render_swimlane_html(G, lanes, args.out)
    else:
        render_swimlane(G, lanes, args.out)

    print(f"Swimlane diagram written to {args.out}")


if __name__ == "__main__":
    main()

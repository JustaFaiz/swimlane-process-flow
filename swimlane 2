def render_swimlane_html(
    G: nx.DiGraph,
    lanes: Dict[str, str],
    out_path: str,
    lane_order: Optional[List[str]] = None,
    title: str = "Workbook Process Flow (Swimlane)",
):
    """CLI/file convenience wrapper around swimlane_html_string()."""
    html = swimlane_html_string(G, lanes, lane_order=lane_order, title=title)
    Path(out_path).write_text(html, encoding="utf-8")


